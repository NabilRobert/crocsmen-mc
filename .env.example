SERVER_DOMAIN=mc.example.com
MC_VERSION=26.2
MC_MEMORY=6G
TZ=Asia/Jakarta
MC_MOTD="Friends server"
MAX_PLAYERS=10
DIFFICULTY=normal
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
ONLINE_MODE=TRUE
WHITELIST=playername1,playername2
OPS=playername1
# TODO(security): RCON is passwordless on purpose for now (image default password, port 25575 is NOT published).
# Secure this later by setting RCON_PASSWORD=<long random value>, then run: docker compose up -d
# RCON_PASSWORD=
MODRINTH_PROJECTS=fabric-api
INSTALL_COBBLEMON=false
BACKUP_INTERVAL=6h
PRUNE_BACKUPS_DAYS=7
